<Window x:Class="VISTA.EquipoFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Equipo"
        Height="680"
        Width="960"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#F4F6F9"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderBrushDark" Color="#DDE1E9"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#111827"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#6B7280"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#1A56DB"/>
        <SolidColorBrush x:Key="AccentStrongBrush" Color="#1A56DB"/>

        <DropShadowEffect x:Key="WindowShadow"
                           BlurRadius="15"
                           ShadowDepth="0"
                           Opacity="0.15"/>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="#111827"/>
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="InputComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentStrongBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="15"
            CornerRadius="8"
            Background="{StaticResource WindowBackground}"
            BorderBrush="#DDE1E9"
            BorderThickness="1"
            Effect="{StaticResource WindowShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Grid.Row="0"
                    Background="#1E3A5F"
                    CornerRadius="7,7,0,0"
                    MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Equipo"
                                   VerticalAlignment="Center"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="✕"
                                Style="{StaticResource WindowActionButtonStyle}"
                                Click="BtnCancelar_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24,20,24,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock x:Name="txtTituloVentana"
                                   Text="Nuevo equipo"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontSize="22"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="txtSubtituloVentana"
                                   Text="Crea un equipo y agrega trabajadores por correo."
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="13"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1"
                            Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrushDark}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="20">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="Nombre del equipo" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="txtNombre" Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,14" TextChanged="TxtNombre_TextChanged"/>

                                <TextBlock Text="Descripción" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="txtDescripcion"
                                         Height="80"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         Padding="10,8"
                                         VerticalScrollBarVisibility="Auto"
                                         Margin="0,0,0,14"/>

                                <TextBlock Text="Supervisor asignado" Style="{StaticResource LabelStyle}"/>
                                <ComboBox x:Name="cbSupervisor"
                                          Style="{StaticResource InputComboStyle}"
                                          DisplayMemberPath="NombreCompleto"
                                          SelectedValuePath="IdUsuario"
                                          Margin="0,0,0,14"
                                          SelectionChanged="CbSupervisor_SelectionChanged"/>

                                <TextBlock Text="Agregar trabajador por nombre" Style="{StaticResource LabelStyle}"/>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>

                                    <ComboBox Grid.Column="0"
                                              x:Name="cbTrabajador"
                                              Style="{StaticResource InputComboStyle}"
                                              IsEditable="True"
                                              DisplayMemberPath="NombreCompleto"
                                              SelectedValuePath="IdUsuario"
                                              IsTextSearchEnabled="True"/>
                                    <Button Grid.Column="2"
                                            Content="Agregar"
                                            Height="38"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="BtnAgregarCorreo_Click"/>
                                </Grid>

                                <Button Content="Quitar seleccionado"
                                        HorizontalAlignment="Left"
                                        Padding="14,0"
                                        Height="34"
                                        Margin="0,0,0,12"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="BtnQuitarSeleccionado_Click"/>

                                <Border BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="4" Background="White">
                                    <DataGrid x:Name="dgMiembros"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              IsReadOnly="True"
                                              Height="180"
                                              BorderThickness="0"
                                              HeadersVisibility="Column"
                                              RowHeight="36"
                                              Background="White"
                                              AlternatingRowBackground="#F9FAFB">
                                        <DataGrid.ColumnHeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background" Value="#F8FAFC"/>
                                                <Setter Property="Foreground" Value="#374151"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="FontSize" Value="12"/>
                                                <Setter Property="Padding" Value="8,0"/>
                                                <Setter Property="BorderBrush" Value="#DDE1E9"/>
                                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            </Style>
                                        </DataGrid.ColumnHeaderStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Nombre" Binding="{Binding NombreCompleto}" Width="*"/>
                                            <DataGridTextColumn Header="Correo" Binding="{Binding Correo}" Width="180"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <Grid Grid.Column="2" VerticalAlignment="Stretch">
                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrushDark}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="20"
                            Margin="0,68,0,0"
                            VerticalAlignment="Stretch">
                        <StackPanel>
                            <TextBlock Text="Resumen" Foreground="{StaticResource TextPrimary}" FontSize="16" FontWeight="Bold"/>
                            
                            <TextBlock Text="Nombre:" Foreground="{StaticResource TextSecondary}" Margin="0,16,0,4" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock x:Name="txtResumenNombre" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="14"/>

                            <TextBlock Text="Supervisor:" Foreground="{StaticResource TextSecondary}" Margin="0,16,0,4" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock x:Name="txtResumenSupervisor" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="14"/>

                            <TextBlock Text="Miembros:" Foreground="{StaticResource TextSecondary}" Margin="0,16,0,4" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock x:Name="txtCantidadMiembros" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="16"/>

                            <Border Background="#EFF6FF" CornerRadius="4" Padding="12" Margin="0,24,0,0" BorderBrush="#BFDBFE" BorderThickness="1">
                                <TextBlock Text="Este equipo quedará dentro del proyecto seleccionado."
                                           Foreground="#1D4ED8"
                                           FontSize="12.5"
                                           TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.Row="2"
                    Background="#F1F3F5"
                    BorderBrush="#DDE1E9"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,7,7">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="20,12,20,12">
                    <Button Content="Cancelar"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="BtnCancelar_Click"/>
                    <Button x:Name="btnGuardar"
                            Content="Guardar equipo"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="10,0,0,0"
                            Click="BtnGuardar_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>