<Window x:Class="VISTA.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uc="clr-namespace:VISTA.UserControls"
        Title="SCRUM Manager"
        Height="860" Width="1440"
        Background="#F4F6F9"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Tab item empresarial -->
        <Style x:Key="TabNavStyle" TargetType="TabItem">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="FontWeight"      Value="Normal"/>
            <Setter Property="Padding"         Value="20,0"/>
            <Setter Property="Height"          Value="52"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tabBorder"
                                Background="Transparent"
                                BorderThickness="0,0,0,3"
                                BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="{StaticResource AccentPrimary}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentPrimary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style for menu radio buttons in sidebar -->
        <Style x:Key="MenuRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="GroupName" Value="MenuNavigation"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="12,4,12,4"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <Grid>
                                <!-- Hover background for smooth fade -->
                                <Border x:Name="hoverBorder" Background="#1E293B" Opacity="0" CornerRadius="6"/>
                                
                                <Border Padding="{TemplateBinding Padding}">
                                    <Grid>
                                        <!-- Left indicator bar -->
                                        <Border x:Name="indicator" Width="4" Height="20" Background="{StaticResource AccentPrimary}" CornerRadius="2" HorizontalAlignment="Left" Visibility="Collapsed"/>
                                        <ContentPresenter Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BgCard}"/>
                                <Setter TargetName="indicator" Property="Visibility" Value="Visible"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <MultiTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hoverBorder" 
                                                             Storyboard.TargetProperty="Opacity" 
                                                             To="1" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.EnterActions>
                                <MultiTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hoverBorder" 
                                                             Storyboard.TargetProperty="Opacity" 
                                                             To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.ExitActions>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar colapsable -->
            <ColumnDefinition x:Name="SidebarCol" Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ SIDEBAR ═════════════════════════════════════════════════════ -->
        <Border Grid.Column="0"
                x:Name="SidebarContainer"
                Width="220"
                Background="{StaticResource BgSecondary}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,0,1,0"
                ClipToBounds="True">
            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <Border Grid.Row="0" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="25,0">
                    <TextBlock Text="ScrumBoard"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- Menú de navegación -->
                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                    <RadioButton x:Name="btnMenuEmpresa"
                                 Content="🏢  Empresa"
                                 Style="{StaticResource MenuRadioButtonStyle}"
                                 IsChecked="True"
                                 Click="BtnMenuEmpresa_Click"/>
                    
                    <RadioButton x:Name="btnMenuProyectos"
                                 Content="📁  Proyectos"
                                 Style="{StaticResource MenuRadioButtonStyle}"
                                 Click="BtnMenuProyectos_Click"/>
                    
                    <RadioButton x:Name="btnMenuEquipo"
                                 Content="👥  Equipo"
                                 Style="{StaticResource MenuRadioButtonStyle}"
                                 Click="BtnMenuEquipo_Click"/>
                    
                    <RadioButton x:Name="btnMenuUsuarios"
                                 Content="👤  Usuarios"
                                 Style="{StaticResource MenuRadioButtonStyle}"
                                 Visibility="Collapsed"
                                 Click="BtnMenuUsuarios_Click"/>
                    
                    <RadioButton x:Name="btnMenuReportes"
                                 Content="📊  Reportes"
                                 Style="{StaticResource MenuRadioButtonStyle}"
                                 Click="BtnMenuReportes_Click"/>
                    
                    <RadioButton x:Name="btnMenuPeriodo"
                                 Content="⏱  Periodo"
                                 Style="{StaticResource MenuRadioButtonStyle}"
                                 Click="BtnMenuPeriodo_Click"/>
                </StackPanel>

                <!-- Info sesión -->
                <Border Grid.Row="2" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" Background="Transparent">
                    <Grid>
                        <ToggleButton x:Name="btnPerfilDropdown"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Cursor="Hand"
                                      HorizontalContentAlignment="Stretch"
                                      Padding="16,14">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{TemplateBinding Background}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource BgCard}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Background" Value="{StaticResource BgCard}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Avatar Circular -->
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="{StaticResource AccentPrimary}" Margin="0,0,12,0">
                                    <TextBlock x:Name="txtAvatarInicial" Text="U" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Info Usuario -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="txtSidebarNombre"
                                               Text="Usuario"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="txtSidebarRol"
                                               Text="Rol"
                                               FontSize="11" Foreground="{StaticResource TextSecondary}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Icono Desplegable -->
                                <Path Grid.Column="2" Data="M6 9L12 15L18 9" 
                                      Stroke="{StaticResource TextSecondary}" StrokeThickness="2" 
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                            </Grid>
                        </ToggleButton>

                        <!-- Popup del menú -->
                        <Popup x:Name="popPerfil"
                               IsOpen="{Binding IsChecked, ElementName=btnPerfilDropdown, Mode=TwoWay}"
                               PlacementTarget="{Binding ElementName=btnPerfilDropdown}"
                               Placement="Top"
                               StaysOpen="False"
                               PopupAnimation="Slide"
                               AllowsTransparency="True"
                               VerticalOffset="-8"
                               HorizontalOffset="8">
                            <Border Background="{StaticResource BgCard}" 
                                    BorderBrush="{StaticResource BorderColor}" 
                                    BorderThickness="1" 
                                    CornerRadius="6" 
                                    Padding="4"
                                    Width="204"
                                    Margin="0,0,0,8">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" Opacity="0.5" BlurRadius="10" ShadowDepth="4"/>
                                </Border.Effect>
                                
                                <StackPanel>
                                    <!-- Botón de Cerrar Sesión Moderno -->
                                    <Button x:Name="btnCerrarSesion"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Click="BtnCerrarSesion_Click"
                                            Padding="12,8"
                                            HorizontalContentAlignment="Left">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#3F1414"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter Property="Background" Value="#5C1B1B"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M9 21H5C4.46957 21 3.96086 20.7893 3.58579 20.4142C3.21071 20.0391 3 19.5304 3 19V5C3 4.46957 3.21071 3.96086 3.58579 3.58579C3.96086 3.21071 4.46957 3 5 3H9M16 17L21 12M21 12L16 7M21 12H9" 
                                                  Stroke="{StaticResource AccentError}" 
                                                  StrokeThickness="2" 
                                                  StrokeLineJoin="Round" 
                                                  StrokeStartLineCap="Round" 
                                                  StrokeEndLineCap="Round"
                                                  Width="16" Height="16"
                                                  Stretch="Uniform"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock Text="Cerrar sesión" 
                                                       Foreground="{StaticResource AccentError}" 
                                                       FontWeight="Medium" 
                                                       Margin="12,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ═══ ÁREA PRINCIPAL ═══════════════════════════════════════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Barra superior unificada (Hamburguesa + Volver) -->
                <RowDefinition Height="*"/>     <!-- Contenido -->
            </Grid.RowDefinitions>

            <!-- Barra superior unificada (siempre visible para albergar la hamburguesa y el botón volver) -->
            <Border Grid.Row="0"
                    Background="{StaticResource BgPrimary}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="0,0,0,1"
                    Height="48">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Hamburguesa -->
                        <ColumnDefinition Width="*"/>    <!-- Botón Volver -->
                    </Grid.ColumnDefinitions>

                    <!-- Botón Hamburguesa -->
                    <Button Grid.Column="0"
                            x:Name="btnHamburguesa"
                            Content="☰"
                            Width="36" Height="36"
                            FontSize="16"
                            Background="Transparent"
                            Foreground="{StaticResource TextPrimary}"
                            BorderThickness="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Cursor="Hand"
                            Click="BtnHamburguesa_Click"/>

                    <!-- Botón Volver (dentro del mismo espacio para no duplicar barras) -->
                    <StackPanel Grid.Column="1"
                                x:Name="barraVolver"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0"
                                Visibility="Collapsed">
                        <Button x:Name="btnVolverPrincipal"
                                Content="← Volver"
                                Height="32" Padding="14,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                FontSize="13"
                                Click="BtnVolverPrincipal_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- TabControl principal (headers ocultos) -->
            <TabControl Grid.Row="1"
                x:Name="MainTabControl"
                Background="Transparent"
                BorderThickness="0"
                SelectionChanged="MainTabControl_SelectionChanged">

                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent"/>
                    </ControlTemplate>
                </TabControl.Template>

                <!-- ── Tab 1: Empresa ── -->
                <TabItem Header="Empresa" Style="{StaticResource TabNavStyle}">
                    <uc:DashboardEmpresaControl x:Name="ctrlEmpresa"/>
                </TabItem>

                <!-- ── Tab 2: Proyectos ── -->
                <TabItem Header="Proyectos" Style="{StaticResource TabNavStyle}">
                    <Grid x:Name="gridProyectos">
                        <uc:ProyectosControl x:Name="ctrlProyectos"/>
                    </Grid>
                </TabItem>

                <!-- ── Tab 3: Equipo ── -->
                <TabItem Header="Equipo" Style="{StaticResource TabNavStyle}">
                    <Grid x:Name="gridEquipo">
                        <uc:EquiposGeneralControl x:Name="ctrlEquiposGeneral"/>
                    </Grid>
                </TabItem>

                <!-- ── Tab 4: Usuarios (solo Admin) ── -->
                <TabItem Header="Usuarios" Style="{StaticResource TabNavStyle}"
                          x:Name="tabUsuarios" Visibility="Collapsed">
                    <uc:UsuariosControl x:Name="ctrlUsuarios"/>
                </TabItem>

                <!-- ── Tab 5: Reportes ── -->
                <TabItem Header="Reportes" Style="{StaticResource TabNavStyle}">
                    <uc:ReportesControl/>
                </TabItem>

                <!-- ── Tab 6: Periodo ── -->
                <TabItem Header="Periodo" Style="{StaticResource TabNavStyle}">
                    <uc:PeriodoControl/>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>