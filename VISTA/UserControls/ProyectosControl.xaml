<UserControl x:Class="VISTA.UserControls.ProyectosControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="{StaticResource BgPrimary}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Border Grid.Row="0"
                Background="{StaticResource BgSecondary}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,0,0,1"
                Padding="28,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Proyectos"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock x:Name="txtSubtitulo"
                               Text="Gestiona los proyectos de tu empresa"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondary}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="txtBuscar"
                             Width="220" Margin="0,0,12,0"
                             TextChanged="TxtBuscar_TextChanged"/>
                    <Button Content="+ Nuevo Proyecto"
                            Click="BtnNuevoProyecto_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Estadísticas -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="28,16,28,0">
            <Border Style="{StaticResource CardStyle}"
                    Padding="16,12" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Activos"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtActivos" Text="0"
                               FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource AccentSuccess}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}"
                    Padding="16,12" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="En Pausa"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtPausados" Text="0"
                               FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource AccentWarning}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}"
                    Padding="16,12" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Finalizados"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtFinalizados" Text="0"
                               FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}"
                    Padding="16,12">
                <StackPanel>
                    <TextBlock Text="Total"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtTotal" Text="0"
                               FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource AccentPrimary}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Grid de Cards -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="28,16,28,16">
            <WrapPanel x:Name="panelCards" Orientation="Horizontal"/>
        </ScrollViewer>
    </Grid>
</UserControl>
