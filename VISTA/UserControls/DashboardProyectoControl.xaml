<UserControl x:Class="VISTA.UserControls.DashboardProyectoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="{StaticResource BgPrimary}">

    <UserControl.Resources>
        <Style x:Key="DarkTabItemStyle" TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tabBorder"
                                Background="Transparent"
                                BorderThickness="0,0,0,2"
                                BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <!-- Smooth hover pill background -->
                                <Border x:Name="hoverPill" 
                                        Background="#1E293B" 
                                        Opacity="0" 
                                        CornerRadius="4" 
                                        Margin="-8,-4"/>
                                        
                                <ContentPresenter x:Name="contentPresenter"
                                                  ContentSource="Header"
                                                  Focusable="False"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  SnapsToDevicePixels="True"
                                                  RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="{StaticResource AccentPrimary}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hoverPill" 
                                                             Storyboard.TargetProperty="Opacity" 
                                                             To="0.6" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hoverPill" 
                                                             Storyboard.TargetProperty="Opacity" 
                                                             To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Border Grid.Row="0"
                Background="{StaticResource BgSecondary}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,0,0,1"
                Padding="28,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="txtTituloEquipos"
                               Text="Equipos del Proyecto"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="Equipos asignados a este proyecto"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondary}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="+ Nuevo equipo"
                            Height="36" Padding="14,0"
                            Click="BtnNuevoEquipo_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- TabControl: Equipos | Archivos Generales -->
        <TabControl Grid.Row="1" x:Name="tabControlProyecto"
                    Background="{StaticResource BgPrimary}"
                    BorderThickness="0"
                    SelectionChanged="TabControlProyecto_SelectionChanged">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource DarkTabItemStyle}"/>
            </TabControl.Resources>

            <!-- Tab 1: Equipos -->
            <TabItem Header="Equipos">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="panelEquipoCards"
                               Orientation="Horizontal"
                               Margin="24,20,24,20"/>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: Archivos Generales -->
            <TabItem Header="Archivos Generales" x:Name="tabItemArchivosGenerales">
                <Grid Margin="24,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Acciones archivos -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Archivos del proyecto y sus equipos"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0"/>
                        <Button Content="↑ Subir a Proyecto"
                                Height="34" Padding="14,0"
                                Margin="0,0,8,0"
                                Click="BtnSubirArchivoProyecto_Click"/>
                        <Button Content="↓ Descargar / Abrir"
                                Height="34" Padding="14,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,8,0"
                                Click="BtnDescargarArchivoProyecto_Click"/>
                        <Button Content="🗑 Eliminar"
                                Height="34" Padding="14,0"
                                Style="{StaticResource DangerButtonStyle}"
                                Click="BtnEliminarArchivoProyecto_Click"/>
                    </StackPanel>

                    <!-- DataGrid archivos -->
                    <Border Grid.Row="1"
                            Background="{StaticResource BgCard}"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="1" CornerRadius="6">
                        <DataGrid x:Name="dgArchivosProyecto"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  Background="{StaticResource BgCard}"
                                  RowBackground="{StaticResource BgCard}"
                                  AlternatingRowBackground="{StaticResource BgSecondary}"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  BorderThickness="0"
                                  ColumnHeaderHeight="38"
                                  RowHeight="40"
                                  MouseDoubleClick="DgArchivosProyecto_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nombre"         Binding="{Binding NombreOriginal}" Width="*"/>
                                <DataGridTextColumn Header="Tipo"           Binding="{Binding Extension}"     Width="80"/>
                                <DataGridTextColumn Header="Tamaño"         Binding="{Binding Tamano}"        Width="100"/>
                                <DataGridTextColumn Header="Origen"         Binding="{Binding Origen}"        Width="160"/>
                                <DataGridTextColumn Header="Fecha de Subida" Binding="{Binding FechaSubida}"  Width="140"/>
                                <DataGridTextColumn Header="Subido Por"     Binding="{Binding SubidoPor}"     Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
