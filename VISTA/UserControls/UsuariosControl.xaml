<UserControl x:Class="VISTA.UserControls.UsuariosControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="{StaticResource BgPrimary}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Border Grid.Row="0"
                Background="{StaticResource BgSecondary}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,0,0,1"
                Padding="28,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Usuarios"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="Gestión de usuarios del sistema"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondary}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="txtBuscar"
                             Height="36" Width="220" Margin="0,0,12,0"
                             Text="Buscar por nombre o correo..."
                             GotFocus="TxtBuscar_GotFocus"
                             LostFocus="TxtBuscar_LostFocus"
                             TextChanged="TxtBuscar_TextChanged"/>
                    <Button Content="+ Nuevo usuario"
                            Click="BtnNuevo_Click"/>
                    <Button x:Name="btnEditarTop"
                            Content="Editar"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="8,0,0,0"
                            Click="BtnEditarTop_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tabla de usuarios -->
        <Border Grid.Row="1"
                Background="{StaticResource BgCard}"
                Margin="28,16"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1" CornerRadius="6">
            <DataGrid x:Name="dgUsuarios"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      Background="{StaticResource BgCard}"
                      RowBackground="{StaticResource BgCard}"
                      AlternatingRowBackground="{StaticResource BgSecondary}"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      BorderThickness="0"
                      ColumnHeaderHeight="40"
                      RowHeight="42"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      Margin="0">
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1E3A5F"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentPrimary}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nombre"    Binding="{Binding Nombre}"        Width="130"/>
                    <DataGridTextColumn Header="Apellido"  Binding="{Binding Apellido}"       Width="130"/>
                    <DataGridTextColumn Header="Correo"    Binding="{Binding Email}"          Width="200"/>
                    <DataGridTextColumn Header="Rol"       Binding="{Binding RolDisplay}"     Width="100"/>
                    <DataGridTextColumn Header="Nivel"     Binding="{Binding NivelJerarquico}" Width="60"/>
                    <DataGridTextColumn Header="Superior"  Binding="{Binding NombreSuperior}" Width="150"/>
                    <DataGridTextColumn Header="Hrs/Sem"   Binding="{Binding HorasSemanalesDisponibles, StringFormat={}{0:0.##}}" Width="80"/>
                    <DataGridTextColumn Header="Estado"    Binding="{Binding EstadoDisplay}"  Width="80"/>
                    <DataGridTemplateColumn Header="Acciones" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                    <Button Content="Desactivar"
                                            Margin="0,0,6,0" Padding="10,4"
                                            Style="{StaticResource DangerButtonStyle}"
                                            FontSize="12"
                                            Visibility="{Binding PuedeDesactivar, Converter={StaticResource BoolToVis}}"
                                            Click="BtnDesactivar_Click"/>
                                    <Button Content="Reactivar"
                                            Padding="10,4"
                                            Style="{StaticResource SuccessButtonStyle}"
                                            FontSize="12"
                                            Visibility="{Binding PuedeReactivar, Converter={StaticResource BoolToVis}}"
                                            Click="BtnReactivar_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
