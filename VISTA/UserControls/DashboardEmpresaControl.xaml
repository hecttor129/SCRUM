<UserControl x:Class="VISTA.UserControls.DashboardEmpresaControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="{StaticResource BgPrimary}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Border Grid.Row="0"
                Background="{StaticResource BgSecondary}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,0,0,1"
                Padding="28,18">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Empresa"
                           FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="Información general de la organización"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondary}"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Contenido -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,24,28,24" MaxWidth="700">

                <!-- Card principal de empresa -->
                <Border Style="{StaticResource CardStyle}"
                        Padding="28,24" Margin="0,0,0,16">
                    <StackPanel>
                        <!-- Título y botón editar -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="txtNombreEmpresa"
                                           Text="—"
                                           FontSize="26" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock x:Name="txtDescripcionEmpresa"
                                           Text="—"
                                           FontSize="13"
                                           Foreground="{StaticResource TextSecondary}"
                                           Margin="0,6,0,0" TextWrapping="Wrap"
                                           MaxWidth="460"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="✏  Editar empresa"
                                    Height="36" Padding="16,0"
                                    VerticalAlignment="Top"
                                    Click="BtnEditarEmpresa_Click"/>
                        </Grid>

                        <!-- Separador -->
                        <Border BorderBrush="{StaticResource BorderColor}"
                                BorderThickness="0,1,0,0"
                                Margin="0,0,0,20"/>

                        <!-- Datos de contacto -->
                        <TextBlock Text="Datos de contacto"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondary}"
                                   Margin="0,0,0,14"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="NIT / Identificación"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondary}"
                                           Margin="0,0,0,4"/>
                                <TextBlock x:Name="txtNitEmpresa"
                                           Text="—"
                                           FontSize="14"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="Correo electrónico"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondary}"
                                           Margin="0,0,0,4"/>
                                <TextBlock x:Name="txtCorreoEmpresa"
                                           Text="—"
                                           FontSize="14"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Teléfono"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondary}"
                                           Margin="0,0,0,4"/>
                                <TextBlock x:Name="txtTelefonoEmpresa"
                                           Text="—"
                                           FontSize="14"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Placeholder dashboard visual -->
                <Border Style="{StaticResource CardStyle}" Padding="28,24">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📊" FontSize="40" HorizontalAlignment="Center"
                                   Foreground="{StaticResource AccentPrimary}"/>
                        <TextBlock Text="Dashboard visual"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   Margin="0,12,0,4"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Próximamente: métricas de rendimiento de la empresa."
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondary}"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="340"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
