<Window x:Class="VISTA.TareaFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tarea"
        Height="680"
        Width="960"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Window.Resources>
        <DropShadowEffect x:Key="WindowShadow" BlurRadius="15" ShadowDepth="0" Opacity="0.5"/>

        <Style x:Key="WindowActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="15"
            CornerRadius="8"
            Background="{StaticResource BgPrimary}"
            BorderBrush="{StaticResource BorderColor}"
            BorderThickness="1"
            Effect="{StaticResource WindowShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Grid.Row="0"
                    Background="{StaticResource BgSecondary}"
                    CornerRadius="7,7,0,0"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Tarea"
                                   VerticalAlignment="Center"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="✕"
                                Style="{StaticResource WindowActionButtonStyle}"
                                Click="BtnCancelar_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24,20,24,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Columna Izquierda: Datos Básicos -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock x:Name="txtTituloVentana"
                                   Text="Nueva Tarea"
                                   Style="{StaticResource TitleStyle}"/>
                        <TextBlock x:Name="txtSubtituloVentana"
                                   Text="Completa los detalles de la tarea y gestiona sus dependencias."
                                   Style="{StaticResource TextSecondaryStyle}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1"
                            Style="{StaticResource CardStyle}"
                            Padding="20">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="Título de la Tarea" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBox x:Name="txtTitulo" Margin="0,0,0,14"/>

                                <TextBlock Text="Descripción" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBox x:Name="txtDescripcion"
                                         Height="80"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Padding="10,8"
                                         Margin="0,0,0,14"
                                         VerticalScrollBarVisibility="Auto"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Prioridad" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <ComboBox x:Name="cbPrioridad" Margin="0,0,0,14">
                                            <ComboBoxItem Content="1 - Muy Baja"/>
                                            <ComboBoxItem Content="2 - Baja"/>
                                            <ComboBoxItem Content="3 - Media"/>
                                            <ComboBoxItem Content="4 - Alta"/>
                                            <ComboBoxItem Content="5 - Muy Alta"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Estado" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <ComboBox x:Name="cbEstado" Margin="0,0,0,14">
                                            <ComboBoxItem Content="Pendiente"/>
                                            <ComboBoxItem Content="EnProgreso"/>
                                            <ComboBoxItem Content="Completada"/>
                                            <ComboBoxItem Content="Cancelada"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Fecha Inicio" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <DatePicker x:Name="dpFechaInicio" Margin="0,0,0,14"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Fecha Límite" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <DatePicker x:Name="dpFechaLimite" Margin="0,0,0,14"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Especialización Requerida" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBox x:Name="txtEspecializacion" Margin="0,0,0,14"/>

                                <!-- Estado de disponibilidad (Lectura) -->
                                <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Padding="12" Margin="0,6,0,0" BorderBrush="{StaticResource AccentPrimary}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox x:Name="chkDisponible" IsEnabled="False" IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <StackPanel>
                                            <TextBlock Text="Tarea Disponible" Foreground="{StaticResource AccentPrimary}" FontWeight="Bold" FontSize="13"/>
                                            <TextBlock Text="La tarea se puede trabajar (no tiene dependencias pendientes)." Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- Columna Derecha: Dependencias -->
                <Border Grid.Column="2"
                        Style="{StaticResource CardStyle}"
                        Padding="20"
                        Margin="0,68,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Dependencias de la Tarea" Foreground="{StaticResource TextPrimary}" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>

                        <StackPanel Grid.Row="1" Margin="0,0,0,14">
                            <TextBlock Text="Seleccionar tarea para depender de ella" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6" FontSize="12" FontWeight="SemiBold"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="cbDependencia" Grid.Column="0"
                                          DisplayMemberPath="Titulo" SelectedValuePath="IdTarea"
                                          IsEditable="True" IsTextSearchEnabled="True"/>
                                <Button Grid.Column="2" Content="Agregar" Height="38" Padding="14,0" Style="{StaticResource PrimaryButtonStyle}" Click="BtnAgregarDep_Click"/>
                            </Grid>
                        </StackPanel>

                        <Border Grid.Row="2" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Background="{StaticResource BgSecondary}" Margin="0,0,0,10">
                            <ListBox x:Name="lstDependencias" Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Titulo}" Padding="8,6" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <Button Grid.Row="3" Content="Quitar Dependencia Seleccionada" Height="34"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="BtnQuitarDep_Click"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Botones de Acción inferior -->
            <Border Grid.Row="2"
                    Background="{StaticResource BgSecondary}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,7,7">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="20,12,20,12">
                    <Button Content="Cancelar"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="BtnCancelar_Click"/>
                    <Button Content="Guardar"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="10,0,0,0"
                            Click="BtnGuardar_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
