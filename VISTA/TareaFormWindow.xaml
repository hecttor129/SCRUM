<Window x:Class="VISTA.TareaFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tarea"
        Height="680"
        Width="950"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <StackPanel Margin="0,0,0,14">
            <TextBlock x:Name="txtTituloVentana"
                       Text="Nueva Tarea"
                       Foreground="White"
                       FontSize="26"
                       FontWeight="Bold"/>
            <TextBlock x:Name="txtSubtituloVentana"
                       Text="Completa los detalles de la tarea y gestiona sus dependencias."
                       Foreground="#94A3B8"
                       FontSize="13"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Contenido Central: Dos Columnas -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Columna Izquierda: Datos Básicos -->
            <Border Grid.Column="0"
                    Background="#111827"
                    CornerRadius="12"
                    Padding="18"
                    Margin="0,0,14,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Título de la Tarea" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox x:Name="txtTitulo" Height="36" Margin="0,0,0,14" VerticalContentAlignment="Center" Padding="8,0"/>

                        <TextBlock Text="Descripción" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox x:Name="txtDescripcion"
                                 Height="80"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Margin="0,0,0,14"
                                 Padding="8"
                                 VerticalScrollBarVisibility="Auto"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Prioridad" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ComboBox x:Name="cbPrioridad" Height="36" Margin="0,0,0,14" VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="1 - Muy Baja"/>
                                    <ComboBoxItem Content="2 - Baja"/>
                                    <ComboBoxItem Content="3 - Media"/>
                                    <ComboBoxItem Content="4 - Alta"/>
                                    <ComboBoxItem Content="5 - Muy Alta"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Estado" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ComboBox x:Name="cbEstado" Height="36" Margin="0,0,0,14" VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="Pendiente"/>
                                    <ComboBoxItem Content="EnProgreso"/>
                                    <ComboBoxItem Content="Completada"/>
                                    <ComboBoxItem Content="Cancelada"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Fecha Inicio" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <DatePicker x:Name="dpFechaInicio" Height="36" Margin="0,0,0,14" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Fecha Límite" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <DatePicker x:Name="dpFechaLimite" Height="36" Margin="0,0,0,14" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Especialización Requerida" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox x:Name="txtEspecializacion" Height="36" Margin="0,0,0,14" VerticalContentAlignment="Center" Padding="8,0"/>

                        <!-- Estado de disponibilidad (Lectura) -->
                        <Border Background="#1F2937" CornerRadius="8" Padding="12" Margin="0,6,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox x:Name="chkDisponible" IsEnabled="False" IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel>
                                    <TextBlock Text="Tarea Disponible" Foreground="White" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="La tarea se puede trabajar (no tiene dependencias pendientes)." Foreground="#94A3B8" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Columna Derecha: Dependencias -->
            <Border Grid.Column="1"
                    Background="#111827"
                    CornerRadius="12"
                    Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Dependencias de la Tarea" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock Text="Seleccionar tarea para depender de ella" Foreground="#94A3B8" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="cbDependencia" Grid.Column="0" Height="36"
                                      DisplayMemberPath="Titulo" SelectedValuePath="IdTarea"
                                      IsEditable="True" IsTextSearchEnabled="True" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="2" Content="Agregar" Width="80" Height="36" FontWeight="Bold" Click="BtnAgregarDep_Click"/>
                        </Grid>
                    </StackPanel>

                    <ListBox Grid.Row="2" x:Name="lstDependencias" Background="#1F2937" Foreground="White" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Titulo}" Padding="6" FontSize="13"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Row="3" Content="Quitar Dependencia Seleccionada" Height="34" Margin="0,10,0,0"
                            Background="#374151" Foreground="White" BorderThickness="0" FontWeight="SemiBold"
                            Click="BtnQuitarDep_Click"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Botones de Acción inferior -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancelar"
                    Width="110"
                    Height="36"
                    Margin="0,0,10,0"
                    Background="Transparent"
                    Foreground="White"
                    BorderBrush="#374151"
                    BorderThickness="1"
                    Click="BtnCancelar_Click"/>
            <Button Content="Guardar"
                    Width="110"
                    Height="36"
                    Background="#2563EB"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    Click="BtnGuardar_Click"/>
        </StackPanel>
    </Grid>
</Window>
