<Window x:Class="VISTA.ProyectoFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Proyecto"
        Height="710"
        Width="1040"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Window.Resources>
        <DropShadowEffect x:Key="WindowShadow" BlurRadius="15" ShadowDepth="0" Opacity="0.15" Color="#64748B"/>

        <Style x:Key="WindowActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>

        <!-- SLIDER MODERNO -->
        <Style x:Key="SliderTrackDecreaseStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="6" Background="{StaticResource AccentPrimary}" CornerRadius="3"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderTrackIncreaseStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="6" Background="{StaticResource BgCard}" CornerRadius="3"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernSliderThumb" TargetType="Thumb">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Ellipse Fill="{StaticResource AccentPrimary}"/>
                            <Ellipse Width="6" Height="6" Fill="#0F172A"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderTrackDecreaseStyle}" Command="Slider.DecreaseLarge"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ModernSliderThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderTrackIncreaseStyle}" Command="Slider.IncreaseLarge"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="15"
            CornerRadius="8"
            Background="{StaticResource BgPrimary}"
            BorderBrush="{StaticResource BorderColor}"
            BorderThickness="1"
            Effect="{StaticResource WindowShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Grid.Row="0"
                    Background="{StaticResource BgSecondary}"
                    CornerRadius="7,7,0,0"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Proyecto"
                                   VerticalAlignment="Center"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="—"
                                Style="{StaticResource WindowActionButtonStyle}"
                                Click="BtnMinimizarVentana_Click"/>
                        <Button Content="✕"
                                Style="{StaticResource WindowActionButtonStyle}"
                                Click="BtnCerrarVentana_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24,20,24,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.28*"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="0.92*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock x:Name="txtTituloVentana"
                                       Text="Nuevo proyecto"
                                       Style="{StaticResource TitleStyle}"/>
                            <TextBlock x:Name="txtSubtituloVentana"
                                       Text="Define la información principal del proyecto."
                                       Margin="0,4,0,0"
                                       Style="{StaticResource TextSecondaryStyle}"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="{StaticResource BgCard}"
                                BorderBrush="{StaticResource AccentPrimary}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12,6"
                                VerticalAlignment="Top">
                            <TextBlock x:Name="txtModoVentana"
                                       Text="Modo creación"
                                       Foreground="{StaticResource AccentPrimary}"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1"
                            Style="{StaticResource CardStyle}"
                            Padding="20">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="0"
                                      Margin="0">

                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Información general" FontWeight="Bold" FontSize="16" Margin="0,0,0,4"/>
                                <TextBlock Text="Completa los datos principales del proyecto."
                                           Margin="0,4,0,16"
                                           Foreground="{StaticResource TextSecondary}"/>

                                <TextBlock Text="Nombre del proyecto" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBox x:Name="txtNombre"
                                         Margin="0,0,0,16"
                                         TextChanged="ActualizarVistaPrevia"/>

                                <TextBlock Text="Descripción" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBox x:Name="txtDescripcion"
                                         Height="112"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         Margin="0,0,0,16"
                                         TextChanged="ActualizarVistaPrevia"/>

                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Supervisor" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <ComboBox x:Name="cbSupervisor"
                                                  DisplayMemberPath="NombreCompleto"
                                                  SelectedValuePath="IdUsuario"
                                                  Margin="0,0,0,16"
                                                  SelectionChanged="ActualizarVistaPrevia"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Estado" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <ComboBox x:Name="cbEstado"
                                                  Margin="0,0,0,16"
                                                  SelectionChanged="ActualizarVistaPrevia">
                                            <ComboBoxItem Content="Activo"/>
                                            <ComboBoxItem Content="Pausado"/>
                                            <ComboBoxItem Content="Finalizado"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Fecha inicio" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <DatePicker x:Name="dpFechaInicio"
                                                    Margin="0,0,0,16"
                                                    SelectedDateChanged="ActualizarVistaPrevia"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Fecha fin" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <DatePicker x:Name="dpFechaFin"
                                                    Margin="0,0,0,16"
                                                    SelectedDateChanged="ActualizarVistaPrevia"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Progreso inicial" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <Border Background="{StaticResource BgSecondary}"
                                        BorderBrush="{StaticResource BorderColor}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="14"
                                        Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="76"/>
                                        </Grid.ColumnDefinitions>

                                        <Slider x:Name="slProgreso"
                                                Minimum="0"
                                                Maximum="100"
                                                TickFrequency="5"
                                                IsSnapToTickEnabled="False"
                                                Value="0"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource ModernSliderStyle}"
                                                ValueChanged="slProgreso_ValueChanged"/>

                                        <Border Grid.Column="1"
                                                Margin="14,0,0,0"
                                                Background="{StaticResource BgCard}"
                                                BorderBrush="{StaticResource BorderColor}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Height="34">
                                            <TextBlock x:Name="txtProgresoValor"
                                                       Text="0%"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimary}"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Sección de Documentos del Proyecto (Historias de Usuario y Hoja de Requerimientos) -->
                                <StackPanel x:Name="spDocumentosCreacion" Margin="0,16,0,0">
                                    <TextBlock Text="Documentos Iniciales" FontWeight="Bold" FontSize="16" Margin="0,0,0,4"/>
                                    <TextBlock Text="Sube los documentos base obligatorios para crear el proyecto."
                                               Margin="0,4,0,16"
                                               Foreground="{StaticResource TextSecondary}"/>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Historias de Usuario -->
                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,12">
                                            <TextBlock Text="Historias de Usuario" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <TextBox x:Name="txtRutaHistorias"
                                                     IsReadOnly="True"
                                                     Margin="0"/>
                                        </StackPanel>
                                        <Button x:Name="btnSubirHistorias"
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Content="Buscar..."
                                                VerticalAlignment="Bottom"
                                                Height="38"
                                                Margin="0,0,0,12"
                                                Padding="14,0"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="BtnSubirHistorias_Click"/>

                                        <!-- Hoja de Requerimientos -->
                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="Hoja de Requerimientos" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <TextBox x:Name="txtRutaRequerimientos"
                                                     IsReadOnly="True"
                                                     Margin="0"/>
                                        </StackPanel>
                                        <Button x:Name="btnSubirRequerimientos"
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Content="Buscar..."
                                                VerticalAlignment="Bottom"
                                                Height="38"
                                                Margin="0"
                                                Padding="14,0"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="BtnSubirRequerimientos_Click"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,68,0,0">
                        <StackPanel>
                            <TextBlock Text="Vista previa" FontWeight="Bold" FontSize="16" Margin="0,0,0,4"/>
                            <TextBlock Text="Así se mostrará el proyecto en el sistema."
                                       Margin="0,4,0,16"
                                       Foreground="{StaticResource TextSecondary}"/>

                            <Border Background="{StaticResource BgSecondary}"
                                    BorderBrush="{StaticResource BorderColor}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="16">
                                <StackPanel>
                                    <Border Background="{StaticResource AccentPrimary}"
                                            CornerRadius="4"
                                            Padding="10,4"
                                            HorizontalAlignment="Left"
                                            Margin="0,0,0,12">
                                        <TextBlock Text="Proyecto"
                                                   FontWeight="SemiBold"
                                                   Foreground="#0F172A"
                                                   FontSize="12"/>
                                    </Border>

                                    <TextBlock x:Name="txtPreviewNombre"
                                               Text="Nombre del proyecto"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimary}"/>

                                    <TextBlock x:Name="txtPreviewDescripcion"
                                               Text="Descripción del proyecto."
                                               Margin="0,8,0,14"
                                               Foreground="{StaticResource TextSecondary}"
                                               TextWrapping="Wrap"
                                               FontSize="13"/>

                                    <WrapPanel Margin="0,0,0,14">
                                        <Border x:Name="bdPreviewEstado"
                                                Style="{StaticResource ChipBorderStyle}"
                                                Background="{StaticResource AccentSuccess}">
                                            <TextBlock x:Name="txtPreviewEstado"
                                                       Text="Activo"
                                                       Foreground="#FFFFFF"
                                                       FontWeight="SemiBold"
                                                       FontSize="11"/>
                                        </Border>

                                        <Border x:Name="bdPreviewSupervisor"
                                                Style="{StaticResource ChipBorderStyle}"
                                                Background="{StaticResource BgCard}">
                                            <TextBlock x:Name="txtPreviewSupervisor"
                                                       Text="Sin asignar"
                                                       Foreground="{StaticResource AccentPrimary}"
                                                       FontWeight="SemiBold"
                                                       FontSize="11"/>
                                        </Border>
                                    </WrapPanel>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Background="{StaticResource BgCard}"
                                                BorderBrush="{StaticResource BorderColor}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="10"
                                                Margin="0,0,6,0">
                                            <StackPanel>
                                                <TextBlock Text="Inicio" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                                <TextBlock x:Name="txtPreviewInicio"
                                                           Text="-"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           FontWeight="SemiBold"
                                                           Margin="0,4,0,0"
                                                           FontSize="13"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="1"
                                                Background="{StaticResource BgCard}"
                                                BorderBrush="{StaticResource BorderColor}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="10"
                                                Margin="6,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Fin" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                                <TextBlock x:Name="txtPreviewFin"
                                                           Text="-"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           FontWeight="SemiBold"
                                                           Margin="0,4,0,0"
                                                           FontSize="13"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="Progreso" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                    <ProgressBar x:Name="pbPreviewProgreso"
                                                 Height="8"
                                                 Margin="0,8,0,6"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="0"
                                                 Foreground="{StaticResource AccentPrimary}"/>
                                    <TextBlock x:Name="txtPreviewProgreso"
                                               Text="0%"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="13"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2"
                            Background="{StaticResource BgSecondary}"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14"
                            Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Tips rápidos"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontSize="13"/>
                            <TextBlock Text="• Usa nombres cortos y fáciles de reconocer."
                                       Margin="0,8,0,0"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="12"/>
                            <TextBlock Text="• Puedes dejar supervisor sin asignar por ahora."
                                       Margin="0,4,0,0"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="12"/>
                            <TextBlock Text="• Define fechas realistas para que el seguimiento sea claro."
                                       Margin="0,4,0,0"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="12"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.Row="2"
                    Background="{StaticResource BgSecondary}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,7,7">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="20,12,20,12">
                    <Button Content="Cancelar"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="BtnCancelar_Click"/>
                    <Button x:Name="btnGuardar"
                            Content="Guardar proyecto"
                            Margin="10,0,0,0"
                            Click="BtnGuardar_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>