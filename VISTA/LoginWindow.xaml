<Window x:Class="VISTA.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Iniciar sesión" Height="450" Width="500"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Border Style="{StaticResource CardStyle}" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center" 
                Width="380" 
                Padding="32">
            <StackPanel>
                <!-- Logo / Título -->
                <TextBlock Text="SCRUMBOARD" 
                           Style="{StaticResource TitleStyle}" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,4"/>
                <TextBlock Text="Inicia sesión para continuar" 
                           Style="{StaticResource TextSecondaryStyle}" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,32"/>

                <!-- Campos de entrada -->
                <TextBlock Text="Correo electrónico" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBox x:Name="txtEmail" Margin="0,0,0,20"/>

                <TextBlock Text="Contraseña" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <PasswordBox x:Name="pwdPassword" Margin="0,0,0,12"/>

                <!-- Mensaje de error -->
                <TextBlock x:Name="txtError" 
                           Foreground="{StaticResource AccentError}" 
                           TextWrapping="Wrap" 
                           Margin="0,4,0,20" 
                           Visibility="Collapsed"/>

                <!-- Botón principal -->
                <Button Content="Iniciar sesión" 
                        Click="BtnLogin_Click" 
                        Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
