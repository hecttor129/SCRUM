<Window x:Class="VISTA.UsuarioFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Usuario" Height="760" Width="920"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Window.Resources>
        <DropShadowEffect x:Key="WindowShadow" BlurRadius="15" ShadowDepth="0" Opacity="0.5"/>

        <Style x:Key="WindowActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HoraBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Width" Value="52"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}"/>
        </Style>
    </Window.Resources>

    <Border Margin="15"
            CornerRadius="8"
            Background="{StaticResource BgPrimary}"
            BorderBrush="{StaticResource BorderColor}"
            BorderThickness="1"
            Effect="{StaticResource WindowShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Grid.Row="0"
                    Background="{StaticResource BgSecondary}"
                    CornerRadius="7,7,0,0"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="txtTitulo"
                                   Text="Usuario"
                                   VerticalAlignment="Center"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="✕"
                                Style="{StaticResource WindowActionButtonStyle}"
                                Click="BtnCancelar_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Cuerpo: dos columnas con scrollviewer para evitar recortes -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="24,20,24,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ===== COLUMNA IZQUIERDA: Datos básicos ===== -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Datos del Usuario" Style="{StaticResource TitleStyle}" FontSize="16" Margin="0,0,0,14"/>

                            <TextBlock Text="Nombre" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBox x:Name="txtNombre" Margin="0,0,0,14"/>

                            <TextBlock Text="Apellido" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBox x:Name="txtApellido" Margin="0,0,0,14"/>

                            <TextBlock Text="Correo electrónico" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBox x:Name="txtEmail" Margin="0,0,0,14"/>

                            <TextBlock Text="Contraseña" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <PasswordBox x:Name="pwdPassword" Height="38" Padding="10,0"
                                         VerticalContentAlignment="Center" BorderBrush="{StaticResource BorderColor}"
                                         Foreground="{StaticResource TextPrimary}"
                                         BorderThickness="1" Background="Transparent" Margin="0,0,0,2"/>
                            <TextBlock x:Name="txtHintPwd" Text="(Dejar vacío para no cambiar la contraseña)"
                                       FontSize="11" Foreground="{StaticResource TextSecondary}" Visibility="Collapsed"
                                       Margin="0,0,0,10"/>

                            <TextBlock Text="Rol" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <ComboBox x:Name="cbRol" Margin="0,0,0,14">
                                <ComboBoxItem Content="Jefe"/>
                                <ComboBoxItem Content="Empleado"/>
                            </ComboBox>

                            <TextBlock Text="Superior directo" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <ComboBox x:Name="cbSuperior" DisplayMemberPath="NombreConNivel"
                                      SelectionChanged="CbSuperior_SelectionChanged" Margin="0,0,0,10"/>
                            <TextBlock x:Name="txtNivelCalculado" Text="Nivel jerárquico asignado: -"
                                       FontSize="12" Foreground="{StaticResource AccentSuccess}" FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>

                            <TextBlock Text="Salario (opcional)" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBox x:Name="txtSalario" Margin="0,0,0,14"/>

                            <TextBlock x:Name="txtError" Foreground="#EF4444" TextWrapping="Wrap"
                                       Margin="0,5,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- ===== COLUMNA DERECHA: Habilidades y Disponibilidad ===== -->
                    <StackPanel Grid.Column="2">

                        <!-- SECCIÓN: Especializaciones -->
                        <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Especialidades" Style="{StaticResource TitleStyle}" FontSize="16" Margin="0,0,0,14"/>

                                <TextBlock Text="Buscar o escribir especialidad" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="cbEspecialidad" Grid.Column="0"
                                              IsEditable="True" Height="38"
                                              VerticalContentAlignment="Center"
                                              KeyDown="CbEspecialidad_KeyDown"/>
                                    <Button Grid.Column="2" Content="Agregar" Height="38"
                                            Padding="16,0" Style="{StaticResource PrimaryButtonStyle}"
                                            Click="BtnAgregarEspecialidad_Click"/>
                                </Grid>

                                <!-- Lista de tags de especialidades -->
                                <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6"
                                        MinHeight="80" MaxHeight="130" Background="{StaticResource BgSecondary}" Padding="10">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <WrapPanel x:Name="wrapEspecialidades" Orientation="Horizontal"/>
                                    </ScrollViewer>
                                </Border>
                                <TextBlock Text="Haz clic en una especialidad para eliminarla."
                                           FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- SECCIÓN: Disponibilidad Semanal -->
                        <Border Style="{StaticResource CardStyle}" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Disponibilidad Semanal" Style="{StaticResource TitleStyle}" FontSize="16" Margin="0,0,0,14"/>
                                <TextBlock Text="Horas de trabajo disponibles por día:" FontWeight="SemiBold" Margin="0,0,0,14"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Etiquetas de días -->
                                    <TextBlock Grid.Column="0" Grid.Row="0" Text="Dom" TextAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,4,8"/>
                                    <TextBlock Grid.Column="1" Grid.Row="0" Text="Lun" TextAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,4,8"/>
                                    <TextBlock Grid.Column="2" Grid.Row="0" Text="Mar" TextAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,4,8"/>
                                    <TextBlock Grid.Column="3" Grid.Row="0" Text="Mié" TextAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,4,8"/>
                                    <TextBlock Grid.Column="4" Grid.Row="0" Text="Jue" TextAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,4,8"/>
                                    <TextBlock Grid.Column="5" Grid.Row="0" Text="Vie" TextAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,4,8"/>
                                    <TextBlock Grid.Column="6" Grid.Row="0" Text="Sáb" TextAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>

                                    <!-- Inputs de horas (DiaSemana 0=Dom … 6=Sáb) -->
                                    <TextBox x:Name="txtHrsDom" Grid.Column="0" Grid.Row="1" Text="0" Style="{StaticResource HoraBoxStyle}" Margin="0,0,4,0"/>
                                    <TextBox x:Name="txtHrsLun" Grid.Column="1" Grid.Row="1" Text="8" Style="{StaticResource HoraBoxStyle}" Margin="0,0,4,0"/>
                                    <TextBox x:Name="txtHrsMar" Grid.Column="2" Grid.Row="1" Text="8" Style="{StaticResource HoraBoxStyle}" Margin="0,0,4,0"/>
                                    <TextBox x:Name="txtHrsMie" Grid.Column="3" Grid.Row="1" Text="8" Style="{StaticResource HoraBoxStyle}" Margin="0,0,4,0"/>
                                    <TextBox x:Name="txtHrsJue" Grid.Column="4" Grid.Row="1" Text="8" Style="{StaticResource HoraBoxStyle}" Margin="0,0,4,0"/>
                                    <TextBox x:Name="txtHrsVie" Grid.Column="5" Grid.Row="1" Text="8" Style="{StaticResource HoraBoxStyle}" Margin="0,0,4,0"/>
                                    <TextBox x:Name="txtHrsSab" Grid.Column="6" Grid.Row="1" Text="0" Style="{StaticResource HoraBoxStyle}" Margin="0,0,0,0"/>
                                </Grid>

                                <TextBlock Text="Valores de 0 a 24 horas por día."
                                           FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Footer: botones -->
            <Border Grid.Row="2" Background="{StaticResource BgSecondary}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" CornerRadius="0,0,7,7">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,12,20,12">
                    <Button Content="Cancelar" Style="{StaticResource SecondaryButtonStyle}" Click="BtnCancelar_Click"/>
                    <Button x:Name="btnGuardar" Content="Guardar" Margin="10,0,0,0" Style="{StaticResource PrimaryButtonStyle}" Click="BtnGuardar_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
