<Window x:Class="VISTA.EmpresaFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración de Empresa"
        Height="700"
        Width="600"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Window.Resources>
        <DropShadowEffect x:Key="WindowShadow"
                           BlurRadius="15"
                           ShadowDepth="0"
                           Opacity="0.5"/>
    </Window.Resources>

    <Border Margin="15"
            CornerRadius="8"
            Background="{StaticResource BgPrimary}"
            BorderBrush="{StaticResource BorderColor}"
            BorderThickness="1"
            Effect="{StaticResource WindowShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Grid.Row="0"
                    Background="{StaticResource BgSecondary}"
                    CornerRadius="7,7,0,0"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Configuración de Empresa"
                                   VerticalAlignment="Center"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="✕"
                                Width="28" Height="28"
                                Background="Transparent"
                                Foreground="{StaticResource TextSecondary}"
                                BorderThickness="0"
                                Cursor="Hand"
                                FontSize="14"
                                Click="BtnCerrarVentana_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24,20,24,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,14">
                    <TextBlock x:Name="txtTituloVentana"
                               Text="Datos de la empresa"
                               Style="{StaticResource TitleStyle}"/>
                    <TextBlock Text="Define la información principal de la compañía."
                               Margin="0,4,0,0"
                               Style="{StaticResource TextSecondaryStyle}"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,10">
                    <Border Style="{StaticResource CardStyle}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Nombre comercial" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBox x:Name="txtNombre" Margin="0,0,0,16"/>

                            <TextBlock Text="Descripción" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBox x:Name="txtDescripcion"
                                     Height="80"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,0,16"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="NIT / Identificación" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBox x:Name="txtNit" Margin="0,0,0,16"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Teléfono" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBox x:Name="txtTelefono" Margin="0,0,0,16"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Correo electrónico" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBox x:Name="txtCorreo" Margin="0,0,0,16"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="2"
                    Background="{StaticResource BgSecondary}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,7,7">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="20,12,20,12">
                    <Button Content="Cancelar"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="BtnCancelar_Click"/>
                    <Button x:Name="btnGuardar"
                            Content="Guardar configuración"
                            Margin="10,0,0,0"
                            Click="BtnGuardar_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
