<Window x:Class="VISTA.ProyectoFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Proyecto"
        Height="710"
        Width="1040"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#F4F6F9"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F4F6F9"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderBrushDark" Color="#DDE1E9"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#111827"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#6B7280"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#1A56DB"/>
        <SolidColorBrush x:Key="AccentStrongBrush" Color="#1A56DB"/>

        <DropShadowEffect x:Key="WindowShadow"
                           BlurRadius="15"
                           ShadowDepth="0"
                           Opacity="0.15"/>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="#111827"/>
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="InputComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <Style x:Key="InputDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Height" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style TargetType="{x:Type primitives:DatePickerTextBox}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentStrongBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>

        <!-- SCROLL -->
        <Style x:Key="ScrollBarInvisibleButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FloatingScrollThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Border x:Name="ThumbBody"
                                    Width="6"
                                    Margin="0,4"
                                    HorizontalAlignment="Center"
                                    Background="#9CA3AF"
                                    CornerRadius="3"
                                    Opacity="0.8"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBody" Property="Background" Value="#6B7280"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FloatingVerticalScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="12" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollBarInvisibleButton}"
                                                  Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource FloatingScrollThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollBarInvisibleButton}"
                                                  Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SLIDER MODERNO -->
        <Style x:Key="SliderTrackDecreaseStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="6"
                                Background="#1A56DB"
                                CornerRadius="3"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderTrackIncreaseStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="6"
                                Background="#DDE1E9"
                                CornerRadius="3"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernSliderThumb" TargetType="Thumb">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Ellipse Fill="#1A56DB"/>
                            <Ellipse Width="6" Height="6" Fill="White"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderTrackDecreaseStyle}"
                                                  Command="Slider.DecreaseLarge"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ModernSliderThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderTrackIncreaseStyle}"
                                                  Command="Slider.IncreaseLarge"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="15"
            CornerRadius="8"
            Background="{StaticResource WindowBackground}"
            BorderBrush="#DDE1E9"
            BorderThickness="1"
            Effect="{StaticResource WindowShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Grid.Row="0"
                    Background="#1E3A5F"
                    CornerRadius="7,7,0,0"
                    MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Proyecto"
                                   VerticalAlignment="Center"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="—"
                                Style="{StaticResource WindowActionButtonStyle}"
                                Click="BtnMinimizarVentana_Click"/>
                        <Button Content="✕"
                                Style="{StaticResource WindowActionButtonStyle}"
                                Click="BtnCerrarVentana_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24,20,24,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.28*"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="0.92*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock x:Name="txtTituloVentana"
                                       Text="Nuevo proyecto"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock x:Name="txtSubtituloVentana"
                                       Text="Define la información principal del proyecto."
                                       Margin="0,4,0,0"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="13"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="#EFF6FF"
                                BorderBrush="#BFDBFE"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12,6"
                                VerticalAlignment="Top">
                            <TextBlock x:Name="txtModoVentana"
                                       Text="Modo creación"
                                       Foreground="#1D4ED8"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1"
                            Style="{StaticResource CardBorderStyle}"
                            Padding="20">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="0"
                                      Margin="0">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource FloatingVerticalScrollBar}"/>
                            </ScrollViewer.Resources>

                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Información general" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="Completa los datos principales del proyecto."
                                           Margin="0,4,0,16"
                                           Foreground="{StaticResource TextSecondary}"/>

                                <TextBlock Text="Nombre del proyecto" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="txtNombre"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         TextChanged="ActualizarVistaPrevia"/>

                                <TextBlock Text="Descripción" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="txtDescripcion"
                                         Height="112"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         Padding="10,8"
                                         Foreground="{StaticResource TextPrimary}"
                                         CaretBrush="#111827"
                                         Background="{StaticResource InputBrush}"
                                         BorderBrush="{StaticResource BorderBrushDark}"
                                         BorderThickness="1"
                                         Margin="0,0,0,16"
                                         TextChanged="ActualizarVistaPrevia"/>

                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Supervisor" Style="{StaticResource LabelStyle}"/>
                                        <ComboBox x:Name="cbSupervisor"
                                                  DisplayMemberPath="NombreCompleto"
                                                  SelectedValuePath="IdUsuario"
                                                  Style="{StaticResource InputComboStyle}"
                                                  SelectionChanged="ActualizarVistaPrevia"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Estado" Style="{StaticResource LabelStyle}"/>
                                        <ComboBox x:Name="cbEstado"
                                                  Style="{StaticResource InputComboStyle}"
                                                  SelectionChanged="ActualizarVistaPrevia">
                                            <ComboBoxItem Content="Activo"/>
                                            <ComboBoxItem Content="Pausado"/>
                                            <ComboBoxItem Content="Finalizado"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Fecha inicio" Style="{StaticResource LabelStyle}"/>
                                        <DatePicker x:Name="dpFechaInicio"
                                                    Style="{StaticResource InputDatePickerStyle}"
                                                    SelectedDateChanged="ActualizarVistaPrevia"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Fecha fin" Style="{StaticResource LabelStyle}"/>
                                        <DatePicker x:Name="dpFechaFin"
                                                    Style="{StaticResource InputDatePickerStyle}"
                                                    SelectedDateChanged="ActualizarVistaPrevia"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Progreso inicial" Style="{StaticResource LabelStyle}"/>
                                <Border Background="#F4F6F9"
                                        BorderBrush="{StaticResource BorderBrushDark}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="14"
                                        Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="76"/>
                                        </Grid.ColumnDefinitions>

                                        <Slider x:Name="slProgreso"
                                                Minimum="0"
                                                Maximum="100"
                                                TickFrequency="5"
                                                IsSnapToTickEnabled="False"
                                                Value="0"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource ModernSliderStyle}"
                                                ValueChanged="slProgreso_ValueChanged"/>

                                        <Border Grid.Column="1"
                                                Margin="14,0,0,0"
                                                Background="White"
                                                BorderBrush="#DDE1E9"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Height="34">
                                            <TextBlock x:Name="txtProgresoValor"
                                                       Text="0%"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimary}"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Sección de Documentos del Proyecto (Historias de Usuario y Hoja de Requerimientos) -->
                                <StackPanel x:Name="spDocumentosCreacion" Margin="0,16,0,0">
                                    <TextBlock Text="Documentos Iniciales" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="Sube los documentos base obligatorios para crear el proyecto."
                                               Margin="0,4,0,16"
                                               Foreground="{StaticResource TextSecondary}"/>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Historias de Usuario -->
                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,12">
                                            <TextBlock Text="Historias de Usuario" Style="{StaticResource LabelStyle}"/>
                                            <TextBox x:Name="txtRutaHistorias"
                                                     Style="{StaticResource InputTextBoxStyle}"
                                                     IsReadOnly="True"
                                                     Margin="0"/>
                                        </StackPanel>
                                        <Button x:Name="btnSubirHistorias"
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Content="Buscar..."
                                                VerticalAlignment="Bottom"
                                                Height="38"
                                                Margin="0,0,0,12"
                                                Padding="14,0"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="BtnSubirHistorias_Click"/>

                                        <!-- Hoja de Requerimientos -->
                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="Hoja de Requerimientos" Style="{StaticResource LabelStyle}"/>
                                            <TextBox x:Name="txtRutaRequerimientos"
                                                     Style="{StaticResource InputTextBoxStyle}"
                                                     IsReadOnly="True"
                                                     Margin="0"/>
                                        </StackPanel>
                                        <Button x:Name="btnSubirRequerimientos"
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Content="Buscar..."
                                                VerticalAlignment="Bottom"
                                                Height="38"
                                                Margin="0"
                                                Padding="14,0"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="BtnSubirRequerimientos_Click"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="20" Margin="0,68,0,0">
                        <StackPanel>
                            <TextBlock Text="Vista previa" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="Así se mostrará el proyecto en el sistema."
                                       Margin="0,4,0,16"
                                       Foreground="{StaticResource TextSecondary}"/>

                            <Border Background="#F4F6F9"
                                    BorderBrush="#DDE1E9"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="16">
                                <StackPanel>
                                    <Border Background="#1A56DB"
                                            CornerRadius="4"
                                            Padding="10,4"
                                            HorizontalAlignment="Left"
                                            Margin="0,0,0,12">
                                        <TextBlock Text="Proyecto"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"
                                                   FontSize="12"/>
                                    </Border>

                                    <TextBlock x:Name="txtPreviewNombre"
                                               Text="Nombre del proyecto"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimary}"/>

                                    <TextBlock x:Name="txtPreviewDescripcion"
                                               Text="Descripción del proyecto."
                                               Margin="0,8,0,14"
                                               Foreground="{StaticResource TextSecondary}"
                                               TextWrapping="Wrap"
                                               FontSize="13"/>

                                    <WrapPanel Margin="0,0,0,14">
                                        <Border x:Name="bdPreviewEstado"
                                                Style="{StaticResource ChipBorderStyle}"
                                                Background="#DCFCE7">
                                            <TextBlock x:Name="txtPreviewEstado"
                                                       Text="Activo"
                                                       Foreground="#166534"
                                                       FontWeight="SemiBold"
                                                       FontSize="11"/>
                                        </Border>

                                        <Border x:Name="bdPreviewSupervisor"
                                                Style="{StaticResource ChipBorderStyle}"
                                                Background="#EFF6FF">
                                            <TextBlock x:Name="txtPreviewSupervisor"
                                                       Text="Sin asignar"
                                                       Foreground="#1D4ED8"
                                                       FontWeight="SemiBold"
                                                       FontSize="11"/>
                                        </Border>
                                    </WrapPanel>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Background="White"
                                                BorderBrush="#DDE1E9"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="10"
                                                Margin="0,0,6,0">
                                            <StackPanel>
                                                <TextBlock Text="Inicio" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                                <TextBlock x:Name="txtPreviewInicio"
                                                           Text="-"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           FontWeight="SemiBold"
                                                           Margin="0,4,0,0"
                                                           FontSize="13"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="1"
                                                Background="White"
                                                BorderBrush="#DDE1E9"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="10"
                                                Margin="6,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Fin" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                                <TextBlock x:Name="txtPreviewFin"
                                                           Text="-"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           FontWeight="SemiBold"
                                                           Margin="0,4,0,0"
                                                           FontSize="13"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="Progreso" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                    <ProgressBar x:Name="pbPreviewProgreso"
                                                 Height="8"
                                                 Margin="0,8,0,6"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="0"/>
                                    <TextBlock x:Name="txtPreviewProgreso"
                                               Text="0%"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="13"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2"
                            Background="#F4F6F9"
                            BorderBrush="#DDE1E9"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14"
                            Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Tips rápidos"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontSize="13"/>
                            <TextBlock Text="• Usa nombres cortos y fáciles de reconocer."
                                       Margin="0,8,0,0"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="12"/>
                            <TextBlock Text="• Puedes dejar supervisor sin asignar por ahora."
                                       Margin="0,4,0,0"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="12"/>
                            <TextBlock Text="• Define fechas realistas para que el seguimiento sea claro."
                                       Margin="0,4,0,0"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="12"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.Row="2"
                    Background="#F1F3F5"
                    BorderBrush="#DDE1E9"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,7,7">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="20,12,20,12">
                    <Button Content="Cancelar"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="BtnCancelar_Click"/>
                    <Button x:Name="btnGuardar"
                            Content="Guardar proyecto"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="BtnGuardar_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>