<Window x:Class="VISTA.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uc="clr-namespace:VISTA.UserControls"
        Title="SCRUM Manager"
        Height="860" Width="1440"
        Background="#F4F6F9"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Tab item empresarial -->
        <Style x:Key="TabNavStyle" TargetType="TabItem">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#6B7280"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="FontWeight"      Value="Normal"/>
            <Setter Property="Padding"         Value="20,0"/>
            <Setter Property="Height"          Value="52"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tabBorder"
                                Background="Transparent"
                                BorderThickness="0,0,0,3"
                                BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="#1A56DB"/>
                                <Setter Property="Foreground" Value="#1A56DB"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#111827"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style for menu radio buttons in sidebar -->
        <Style x:Key="MenuRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="GroupName" Value="MenuNavigation"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="12,4,12,4"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <!-- Left indicator bar -->
                                <Border x:Name="indicator" Width="4" Height="20" Background="#1A56DB" CornerRadius="2" HorizontalAlignment="Left" Visibility="Collapsed"/>
                                <ContentPresenter Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="indicator" Property="Visibility" Value="Visible"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="#F3F4F6"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar colapsable -->
            <ColumnDefinition x:Name="SidebarCol" Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ SIDEBAR ═════════════════════════════════════════════════════ -->
        <Border Grid.Column="0"
                x:Name="SidebarContainer"
                Width="220"
                Background="White"
                BorderBrush="#DDE1E9"
                BorderThickness="0,0,1,0"
                ClipToBounds="True">
            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <Border Grid.Row="0" BorderBrush="#DDE1E9" BorderThickness="0,0,0,1" Padding="25,0">
                    <TextBlock Text="ScrumBoard"
                               FontSize="18" FontWeight="Bold"
                               Foreground="#1E3A5F"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- Menú de navegación -->
                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                    <RadioButton x:Name="btnMenuEmpresa"
                                 Content="🏢  Empresa"
                                 Style="{StaticResource MenuRadioButtonStyle}"
                                 IsChecked="True"
                                 Click="BtnMenuEmpresa_Click"/>
                    
                    <RadioButton x:Name="btnMenuProyectos"
                                 Content="📁  Proyectos"
                                 Style="{StaticResource MenuRadioButtonStyle}"
                                 Click="BtnMenuProyectos_Click"/>
                    
                    <RadioButton x:Name="btnMenuEquipo"
                                 Content="👥  Equipo"
                                 Style="{StaticResource MenuRadioButtonStyle}"
                                 Click="BtnMenuEquipo_Click"/>
                    
                    <RadioButton x:Name="btnMenuUsuarios"
                                 Content="👤  Usuarios"
                                 Style="{StaticResource MenuRadioButtonStyle}"
                                 Visibility="Collapsed"
                                 Click="BtnMenuUsuarios_Click"/>
                    
                    <RadioButton x:Name="btnMenuReportes"
                                 Content="📊  Reportes"
                                 Style="{StaticResource MenuRadioButtonStyle}"
                                 Click="BtnMenuReportes_Click"/>
                    
                    <RadioButton x:Name="btnMenuPeriodo"
                                 Content="⏱  Periodo"
                                 Style="{StaticResource MenuRadioButtonStyle}"
                                 Click="BtnMenuPeriodo_Click"/>
                </StackPanel>

                <!-- Info sesión -->
                <Border Grid.Row="2" BorderBrush="#DDE1E9" BorderThickness="0,1,0,0" Padding="20,14">
                    <StackPanel>
                        <TextBlock x:Name="txtSidebarNombre"
                                   Text="Usuario"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="#111827"/>
                        <TextBlock x:Name="txtSidebarRol"
                                   Text="Rol"
                                   FontSize="11" Foreground="#6B7280"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═══ ÁREA PRINCIPAL ═══════════════════════════════════════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Barra superior unificada (Hamburguesa + Volver) -->
                <RowDefinition Height="*"/>     <!-- Contenido -->
            </Grid.RowDefinitions>

            <!-- Barra superior unificada (siempre visible para albergar la hamburguesa y el botón volver) -->
            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#DDE1E9"
                    BorderThickness="0,0,0,1"
                    Height="48">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Hamburguesa -->
                        <ColumnDefinition Width="*"/>    <!-- Botón Volver -->
                    </Grid.ColumnDefinitions>

                    <!-- Botón Hamburguesa -->
                    <Button Grid.Column="0"
                            x:Name="btnHamburguesa"
                            Content="☰"
                            Width="36" Height="36"
                            FontSize="16"
                            Background="Transparent"
                            Foreground="#374151"
                            BorderThickness="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Cursor="Hand"
                            Click="BtnHamburguesa_Click"/>

                    <!-- Botón Volver (dentro del mismo espacio para no duplicar barras) -->
                    <StackPanel Grid.Column="1"
                                x:Name="barraVolver"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0"
                                Visibility="Collapsed">
                        <Button x:Name="btnVolverPrincipal"
                                Content="← Volver"
                                Height="32" Padding="14,0"
                                Background="White"
                                Foreground="#374151"
                                BorderBrush="#DDE1E9" BorderThickness="1"
                                FontSize="13" Cursor="Hand"
                                Click="BtnVolverPrincipal_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- TabControl principal (headers ocultos) -->
            <TabControl Grid.Row="1"
                x:Name="MainTabControl"
                Background="Transparent"
                BorderThickness="0"
                SelectionChanged="MainTabControl_SelectionChanged">

                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent"/>
                    </ControlTemplate>
                </TabControl.Template>

                <!-- ── Tab 1: Empresa ── -->
                <TabItem Header="Empresa" Style="{StaticResource TabNavStyle}">
                    <uc:DashboardEmpresaControl x:Name="ctrlEmpresa"/>
                </TabItem>

                <!-- ── Tab 2: Proyectos ── -->
                <TabItem Header="Proyectos" Style="{StaticResource TabNavStyle}">
                    <Grid x:Name="gridProyectos">
                        <uc:ProyectosControl x:Name="ctrlProyectos"/>
                    </Grid>
                </TabItem>

                <!-- ── Tab 3: Equipo ── -->
                <TabItem Header="Equipo" Style="{StaticResource TabNavStyle}">
                    <Grid x:Name="gridEquipo">
                        <uc:EquiposGeneralControl x:Name="ctrlEquiposGeneral"/>
                    </Grid>
                </TabItem>

                <!-- ── Tab 4: Usuarios (solo Admin) ── -->
                <TabItem Header="Usuarios" Style="{StaticResource TabNavStyle}"
                          x:Name="tabUsuarios" Visibility="Collapsed">
                    <uc:UsuariosControl x:Name="ctrlUsuarios"/>
                </TabItem>

                <!-- ── Tab 5: Reportes ── -->
                <TabItem Header="Reportes" Style="{StaticResource TabNavStyle}">
                    <uc:ReportesControl/>
                </TabItem>

                <!-- ── Tab 6: Periodo ── -->
                <TabItem Header="Periodo" Style="{StaticResource TabNavStyle}">
                    <uc:PeriodoControl/>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>