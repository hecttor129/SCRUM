<UserControl x:Class="VISTA.UserControls.DashboardProyectoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:uc="clr-namespace:VISTA.UserControls"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="#F4F6F9">


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Border Grid.Row="0" Background="White" BorderBrush="#DDE1E9" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="txtTituloEquipos"
                               Text="Equipos del Proyecto"
                               FontSize="22" FontWeight="Bold" Foreground="#111827"/>
                    <TextBlock Text="Equipos asignados a este proyecto"
                               FontSize="13" Foreground="#6B7280" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="+ Nuevo equipo"
                            Height="36" Padding="14,0"
                            Background="#1A56DB" Foreground="White"
                            FontWeight="SemiBold" FontSize="13"
                            BorderThickness="0" Cursor="Hand"
                            Click="BtnNuevoEquipo_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- TabControl: Equipos | Archivos Generales -->
        <TabControl Grid.Row="1" x:Name="tabControlProyecto"
                    Background="Transparent"
                    BorderThickness="0"
                    SelectionChanged="TabControlProyecto_SelectionChanged">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Padding" Value="18,10"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Foreground" Value="#6B7280"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="#1A56DB"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TabControl.Resources>

            <!-- Tab 1: Equipos -->
            <TabItem Header="Equipos">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="panelEquipoCards"
                               Orientation="Horizontal"
                               Margin="24,20,24,20"/>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: Archivos Generales -->
            <TabItem Header="Archivos Generales" x:Name="tabItemArchivosGenerales">
                <Grid Margin="24,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Acciones archivos -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Archivos del proyecto y sus equipos"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="#111827" VerticalAlignment="Center"
                                   Margin="0,0,16,0"/>
                        <Button Content="↑ Subir a Proyecto"
                                Height="34" Padding="14,0"
                                Background="#1A56DB" Foreground="White"
                                FontWeight="SemiBold" BorderThickness="0"
                                FontSize="12" Cursor="Hand" Margin="0,0,8,0"
                                Click="BtnSubirArchivoProyecto_Click"/>
                        <Button Content="↓ Descargar / Abrir"
                                Height="34" Padding="14,0"
                                Background="White" Foreground="#374151"
                                BorderBrush="#DDE1E9" BorderThickness="1"
                                FontSize="12" Cursor="Hand" Margin="0,0,8,0"
                                Click="BtnDescargarArchivoProyecto_Click"/>
                        <Button Content="🗑 Eliminar"
                                Height="34" Padding="14,0"
                                Background="White" Foreground="#B91C1C"
                                BorderBrush="#FECACA" BorderThickness="1"
                                FontSize="12" Cursor="Hand" Margin="0,0,8,0"
                                Click="BtnEliminarArchivoProyecto_Click"/>
                        <Button x:Name="btnAnalizarIAProyecto"
                                Content="🤖 Analizar con IA"
                                Height="34" Padding="14,0"
                                Background="#7C3AED" Foreground="White"
                                FontWeight="SemiBold" BorderThickness="0"
                                FontSize="12" Cursor="Hand"
                                Click="BtnAnalizarConIA_Click"/>
                    </StackPanel>

                    <!-- DataGrid archivos -->
                    <Border Grid.Row="1" Background="White" BorderBrush="#DDE1E9"
                            BorderThickness="1" CornerRadius="6">
                        <DataGrid x:Name="dgArchivosProyecto"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  Background="White"
                                  RowBackground="White"
                                  AlternatingRowBackground="#F9FAFB"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  BorderThickness="0"
                                  ColumnHeaderHeight="38"
                                  RowHeight="40"
                                  MouseDoubleClick="DgArchivosProyecto_MouseDoubleClick">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background"  Value="#F8FAFC"/>
                                    <Setter Property="Foreground"  Value="#374151"/>
                                    <Setter Property="FontWeight"  Value="SemiBold"/>
                                    <Setter Property="FontSize"    Value="12"/>
                                    <Setter Property="Padding"     Value="12,0"/>
                                    <Setter Property="BorderBrush" Value="#DDE1E9"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nombre"         Binding="{Binding NombreOriginal}" Width="*"/>
                                <DataGridTextColumn Header="Tipo"           Binding="{Binding Extension}"     Width="80"/>
                                <DataGridTextColumn Header="Tamaño"         Binding="{Binding Tamano}"        Width="100"/>
                                <DataGridTextColumn Header="Origen"         Binding="{Binding Origen}"        Width="160"/>
                                <DataGridTextColumn Header="Fecha de Subida" Binding="{Binding FechaSubida}"  Width="140"/>
                                <DataGridTextColumn Header="Subido Por"     Binding="{Binding SubidoPor}"     Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Panel de resultado de análisis IA -->
                    <Border x:Name="panelResultadoIAProyecto"
                            Grid.Row="2" Visibility="Collapsed"
                            Background="#F5F3FF" BorderBrush="#C4B5FD"
                            BorderThickness="1" CornerRadius="8"
                            Margin="0,12,0,0" Padding="16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="🤖 Resultado del análisis IA"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="#5B21B6" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtArchivoAnalizadoProyecto"
                                           FontSize="12" Foreground="#6D28D9"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                                <Button Content="✕ Cerrar"
                                        Height="28" Padding="10,0"
                                        Background="White" Foreground="#6D28D9"
                                        BorderBrush="#C4B5FD" BorderThickness="1"
                                        FontSize="11" Cursor="Hand" Margin="12,0,0,0"
                                        Click="BtnCerrarResultadoIA_Click"/>
                            </StackPanel>
                            <Border Background="White" CornerRadius="6"
                                    BorderBrush="#DDD6FE" BorderThickness="1"
                                    Padding="12" MaxHeight="250">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="txtResultadoIAProyecto"
                                               TextWrapping="Wrap"
                                               FontSize="13" Foreground="#1F2937"
                                               FontFamily="Consolas"/>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Indicador de carga -->
                    <Border x:Name="panelCargandoIAProyecto"
                            Grid.Row="2" Visibility="Collapsed"
                            Background="#F5F3FF" BorderBrush="#C4B5FD"
                            BorderThickness="1" CornerRadius="8"
                            Margin="0,12,0,0" Padding="16">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="⏳" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Analizando documento con IA... Esto puede tardar hasta 3 minutos."
                                       FontSize="13" Foreground="#5B21B6"
                                       VerticalAlignment="Center" FontStyle="Italic"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 3: Documento y análisis IA -->
            <TabItem Header="📄  Documento y análisis" x:Name="tabItemDocumentoAnalisis">
                <uc:DocumentoAnalisisControl x:Name="ctrlDocumentoAnalisis"/>
            </TabItem>

            <!-- Tab 4: Historial IA -->
            <TabItem Header="🤖  Historial IA" x:Name="tabItemHistorialIA">
                <uc:HistorialIAControl x:Name="ctrlHistorialIA"/>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>

